---
/**
 * / — the English landing. Structure lives in components/Landing.astro;
 * the words come from the `landing` collection's en record, editable in
 * /admin without a deploy.
 */
import { getCollection } from "astro:content";
import Landing from "../components/Landing.astro";

const records = await getCollection("landing");
const rec = records.find((r) => r.data.lang === "en")?.data;
if (!rec) throw new Error("landing collection has no en record (en-landing.json)");
---

<Landing
  blocks={rec.blocks}
  footerStory={rec.footerStory}
  lang="en"
  title="Stelstone — the git-based CMS your editors can't break"
  description="Every record is a file in your repo, every publish is a commit, the output is static."
  canonical="https://stelstone.com/"
  altHref="/tr/"
  altLabel="TR"
/>
